# Build trees
build/
build-*/
out/
cmake-build-*/

# Simulation exports. Regenerate with the Studio; see README.
runs/

# Binaries and intermediates stay out of the source history.
*.exe
*.dll
*.lib
*.a
*.obj
*.o
*.pdb
*.ilk
*.zip

# Exception: the published release package under release/ is tracked on
# purpose. Note that release/ itself must not be listed above, because git
# cannot re-include a file whose parent directory is excluded.
# The runs/ rule above still applies inside it, so a Studio launched from the
# release folder cannot drag its simulation exports into a commit.
!release/**/*.exe
!release/**/*.zip

# Editor and OS
.vs/
.vscode/
.idea/
*.user
*.swp
Thumbs.db
.DS_Store
